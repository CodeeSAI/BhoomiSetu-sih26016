# ============================================================
# BhoomiSetu SIH26016 - Environment Configuration Template
# National Land Acquisition & Management Intelligence Platform
# ============================================================
#
# IMPORTANT SECURITY NOTICE:
# - Do NOT commit `.env` or production credentials to source control.
# - Production deployments require server-side gateway authentication.
# - The frontend only consumes public endpoints and authenticated session tokens.
# - When credentials are not provided, BhoomiSetu automatically defaults to:
#   "Credential Required — Official Integration Adapter" or "Official Sandbox".
# ============================================================

# Application Environment ('development' | 'staging' | 'production')
VITE_APP_ENV=development
VITE_APP_TITLE=BhoomiSetu National Land Acquisition Platform
VITE_ENABLE_MOCK_SANDBOX=true

# ------------------------------------------------------------
# 1. Land Records / DILRMP (Digital India Land Records Modernization)
# ------------------------------------------------------------
# Base URL for State Land Records Server (Bhulekh / Meebhoomi / AnyRoR / Dharani)
VITE_DILRMP_BASE_URL=
# Department API Client ID / Key
VITE_DILRMP_API_KEY=
# DILRMP State Code (e.g. MH, UP, KA, GJ, RJ, TN, TS)
VITE_DILRMP_STATE_CODE=

# ------------------------------------------------------------
# 2. ULPIN / Bhu-Aadhar National Registry (NIC / DoLR)
# ------------------------------------------------------------
# National Bhu-Aadhar Gateway URL
VITE_ULPIN_GATEWAY_URL=
# Registered Agency ULPIN Client Token
VITE_ULPIN_API_KEY=
# ULPIN Query Timeout (ms)
VITE_ULPIN_TIMEOUT_MS=5000

# ------------------------------------------------------------
# 3. National API Setu (MeitY)
# ------------------------------------------------------------
# API Setu Gateway Base URL (e.g., https://apisetu.gov.in/api/v1)
VITE_API_SETU_BASE_URL=
# API Setu Client Application ID
VITE_API_SETU_CLIENT_ID=
# API Setu Access Secret (Server-side proxy only in production)
VITE_API_SETU_CLIENT_SECRET=

# ------------------------------------------------------------
# 4. Cadastral GIS / Bharat Maps / NIC-GIS
# ------------------------------------------------------------
# WMS / WFS Cadastral Map Service Endpoint
VITE_CADASTRAL_GIS_ENDPOINT=
# GIS Map Tile Server API Key (if authenticated tile service is used)
VITE_GIS_TILE_API_KEY=

# ------------------------------------------------------------
# 5. Financial Systems / PFMS (Public Financial Management System)
# ------------------------------------------------------------
# PFMS Direct Benefit Transfer (DBT) Agency Endpoint
VITE_PFMS_ENDPOINT=
# PFMS Scheme Code (e.g., LA-DBT-2026)
VITE_PFMS_SCHEME_CODE=
# PFMS Agency Digital Certificate Serial
VITE_PFMS_CERT_SERIAL=

# ------------------------------------------------------------
# 6. Notification Services (Govt SMS Gateway / Email)
# ------------------------------------------------------------
# CDAC / NIC SMS Gateway URL
VITE_SMS_GATEWAY_URL=
# Sender ID (e.g. BHOOMI)
VITE_SMS_SENDER_ID=

# ------------------------------------------------------------
# 7. Document Services / DigiLocker Issuer Gateway
# ------------------------------------------------------------
# DigiLocker Requester Base URL
VITE_DIGILOCKER_BASE_URL=
# DigiLocker Requester ID
VITE_DIGILOCKER_CLIENT_ID=
